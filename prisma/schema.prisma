generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

enum InquiryType{
  GENERAL
  QUOTATION
  SUPPORT 
  OTHER
}

enum ServiceType{
  DESIGN
  WEB
  GRAPHICS
  APP
  MARKETING
  CONSULTING
  OTHERS
}   

model Contact{
  id  Int     @id @default(autoincrement())
  name String 
  inquryType InquiryType  
  serviceRequired  ServiceType
  email   String   @unique @db.VarChar(30)
  message String
  @@index([id])
}
